datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Hotel {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  price       Int
  description String
  location    String
  date        DateTime?

  geometry Json
  images   Json
  reviews  Json

  authorId String? @db.ObjectId @map("author")
  createdAt DateTime? @default(now())
  updatedAt DateTime? @updatedAt

  @@map("hotels")
}

model User {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  email    String @unique
  username String @unique
  password String
  role     String @default("USER")
}

model Review {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  body   String
  rating Int
  date   DateTime @default(now())
}